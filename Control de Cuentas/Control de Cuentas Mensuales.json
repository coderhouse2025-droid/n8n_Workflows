    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  try {\n    const content = item.json.content;\n    const textBlock = Array.isArray(content)\n      ? content.find(b => b.type === 'text')\n      : null;\n    const raw = textBlock ? textBlock.text : JSON.stringify(content);\n\n    // Limpiar posible markdown de Claude\n    const cleaned = raw\n      .replace(/```json\\s*/gi, '')\n      .replace(/```\\s*/g, '')\n      .trim();\n\n    const parsed = JSON.parse(cleaned);\n\n    results.push({\n      json: {\n        Tipo: 'Gasto',\n        Concepto:               parsed.concepto       || parsed.categoria    || '',\n        Nombre_Razon_Social:    parsed.proveedor      || '',\n        Clasificacion:          parsed.clasificacion  || parsed.categoria    || 'Otro',\n        Numero_Factura:         String(parsed.numeroFactura || ''),\n        Fecha_Vencimiento_Pago: parsed.fecha          || '',\n        Forma_Pago:             parsed.formaPago      || '',\n        Monto:                  Number(parsed.monto)  || 0\n      }\n    });\n  } catch (e) {\n    // Guardar el error pero continuar con los demás items\n    results.push({\n      json: {\n        Tipo: 'Gasto',\n        Concepto: 'Error al procesar factura',\n        Nombre_Razon_Social: '',\n        Clasificacion: 'Otro',\n        Numero_Factura: '',\n        Fecha_Vencimiento_Pago: '',\n        Forma_Pago: '',\n        Monto: 0,\n        _error: e.message,\n        _raw: JSON.stringify(item.json).slice(0, 300)\n      }\n    });\n  }\n}\nreturn results;"
      },
