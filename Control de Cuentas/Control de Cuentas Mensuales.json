    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ingresos = items.filter(i => i.json.Tipo === 'Ingreso');\nconst gastos = items.filter(i => i.json.Tipo === 'Gasto');\n\nconst totalIngresos = ingresos.reduce((sum, i) => sum + (Number(i.json.Monto) || 0), 0);\nconst totalGastos = gastos.reduce((sum, i) => sum + (Number(i.json.Monto) || 0), 0);\nconst balance = totalIngresos - totalGastos;\n\nconst fecha = new Date().toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' });\n\nconst listaIngresos = ingresos.map(i =>\n  `  - ${i.json.Concepto} | ${i.json.Nombre_Razon_Social} | $${i.json.Monto}`\n).join('\\n') || '  (Sin ingresos registrados)';\n\nconst listaGastos = gastos.map(i =>\n  `  - ${i.json.Concepto} | ${i.json.Nombre_Razon_Social} | $${i.json.Monto} | ${i.json.Clasificacion}`\n).join('\\n') || '  (Sin gastos registrados)';\n\nconst cuerpo = `Resumen del período procesado el ${fecha}\\n\\n` +\n  `INGRESOS (${ingresos.length} registros):\\n${listaIngresos}\\n\\n` +\n  `GASTOS (${gastos.length} registros):\\n${listaGastos}\\n\\n` +\n  `TOTAL INGRESOS: $${totalIngresos.toFixed(2)}\\n` +\n  `TOTAL GASTOS:   $${totalGastos.toFixed(2)}\\n` +\n  `BALANCE:        $${balance.toFixed(2)}\\n\\n` +\n  `Los datos ya están disponibles en Airtable (Tablero de Control).`;\n\nreturn [{ json: { cuerpo, totalIngresos, totalGastos, balance, fecha } }];"
      },
