      "id": "3a61ac55-4ed0-4d9b-886a-51ab8af26986",
      "name": "Claude – Extraer Datos Factura",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        4096,
        -32
      ],
